{
  "settings": {
    "motionStrength": 1,
    "autofocus": "pointer-movement",
    "focusAfterScroll": "none",
    "magneticCentering": false,
    "autoCenter": true,
    "autoCenterDistance": 180,
    "panMomentum": true,
    "zoomClickThreshold": 0.5,
    "showMenuBar": true,
    "showStripMap": false,
    "stripWidths": [
      0.333333,
      0.5,
      0.666667,
      1
    ],
    "mod": "alt+cmd",
    "snap": "none",
    "newWindowPlacement": "beside-focused",
    "hotReload": true,
    "hud": true,
    "inactiveOpacity": 1,
    "gaps": {
      "inner": 12,
      "top": 14,
      "bottom": 12,
      "left": 12,
      "right": 12
    },
    "border": {
      "enabled": true,
      "width": 2,
      "radius": 12,
      "active": "#66b8ff",
      "activeEnd": "#b48cff",
      "inactive": "#ffffff24",
      "attention": "#ffb454",
      "travel": true,
      "spin": 0
    },
    "animations": {
      "windows": {
        "duration": 0.36,
        "bounce": 0
      },
      "scroll": {
        "speed": 22
      },
      "overview": {
        "duration": 0.34
      },
      "open": "popin",
      "close": "shrink"
    },
    "overview": {
      "dim": 0.38
    },
    "commands": {
      "terminal": "open -na Ghostty",
      "browser": "open -b org.mozilla.firefox"
    },
    "swipeGain": 1.15,
    "pinchGain": 1.35,
    "dimInactive": 0.2,
    "attention": "badge",
    "haptics": true,
    "autoPip": true,
    "wallpaper": {
      "parallax": 0
    }
  },
  "shortcuts": {
    "left": "mod+left",
    "right": "mod+right",
    "up": "mod+up",
    "down": "mod+down",
    "move-left": "mod+shift+left",
    "move-right": "mod+shift+right",
    "move-up": "mod+shift+up",
    "move-down": "mod+shift+down",
    "select-window-alt": "ctrl+up",
    "maximize": "shift+cmd+return",
    "select-window": "ctrl+return",
    "fit-focused": "mod+f",
    "actual-size": "mod+0",
    "float": "cmd+space",
    "center": "mod+c",
    "home": "mod+h",
    "undo": "mod+z",
    "previous": "mod+tab",
    "preset-width": "mod+r",
    "close": "cmd+q",
    "terminal": "cmd+return",
    "browser": "shift+cmd+w",
    "commands": "ctrl+alt+p",
    "pause": "ctrl+alt+shift+p",
    "reload-config": "ctrl+alt+r"
  },
  "appRules": {
    "com.apple.Safari": {
      "width": 0.666667,
      "floating": false,
      "openBesideCurrent": true
    },
    "com.apple.Notes": {
      "width": 760,
      "floating": false,
      "openBesideCurrent": true
    },
    "com.apple.Calculator": {
      "width": 420,
      "floating": true,
      "openBesideCurrent": false
    }
  },
  "exec": {
    "mod+shift+f": "open -a Finder"
  },
  "windowRules": [
    {
      "app": "org.mozilla.firefox",
      "title": "^Library$",
      "floating": true
    }
  ],
  "jump": {
    "mod+g": "com.mitchellh.ghostty",
    "mod+shift+b": {
      "app": "org.mozilla.firefox",
      "launch": "open -a Safari"
    }
  }
}
